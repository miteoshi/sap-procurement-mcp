# CAP
CAP_SERVICE_URL=http://localhost:4004/odata/v4/procurement

# Development (Mock Auth)
CAP_DEV_USER=alice
CAP_DEV_PASSWORD=

# Production (XSUAA)
XSUAA_TOKEN_URL=
XSUAA_CLIENT_ID=local-dev
XSUAA_CLIENT_SECRET=local-dev-secret

# Logging
LOG_LEVEL=info

# Environment
NODE_ENV=development
# Optional explicit FMCG Retail CAP service URL. If omitted, the MCP server
# derives /retail from CAP_SERVICE_URL (which points to /procurement).
RETAIL_SERVICE_URL=http://localhost:4004/odata/v4/retail
