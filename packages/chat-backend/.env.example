# --- LLM ---------------------------------------------------------------
# Required. Claude Desktop uses your Claude subscription; a custom UI calls the
# API instead, which is billed separately per token.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# --- Server ------------------------------------------------------------
PORT=8787
# Keep on loopback until you add authentication (see README "Before you deploy").
HOST=127.0.0.1
ALLOWED_ORIGIN=http://localhost:3000
DB_PATH=./data/chat.sqlite

# Signs tool-approval requests so a modified browser can't forge an "approved"
# for cancel_purchase_order etc. If unset, a random one is generated per start
# (pending approvals are then invalidated by a restart).
# Generate one: openssl rand -hex 32
TOOL_APPROVAL_SECRET=

# --- MCP connector (spawned over stdio) ---------------------------------
# Option A (default): run the compiled server.   pnpm --filter mcp-server build
MCP_COMMAND=node
MCP_ARGS=dist/server.js
# Option B: run from source without building
# MCP_COMMAND=npx
# MCP_ARGS=tsx src/server.ts
#
# cwd matters: the MCP server loads its own .env (CAP_SERVICE_URL, XSUAA_*)
# from its working directory via dotenv. The spawned process does NOT inherit
# this process's environment (only PATH/HOME/etc.), by design of the stdio transport.
MCP_CWD=../mcp-server
