# Where the chat-backend listens. The browser calls it directly (CORS is allowed
# for ALLOWED_ORIGIN in the backend's .env).
NEXT_PUBLIC_API_URL=http://localhost:8787

# Optional: how the Next.js *server* reaches the backend when that differs from
# what the browser uses (e.g. a docker service name). Defaults to NEXT_PUBLIC_API_URL.
# BACKEND_URL=http://chat-backend:8787

# Default speech language for voice input/output. Users can change it in the UI.
# en-IN, hi-IN, gu-IN, en-US ...
NEXT_PUBLIC_VOICE_LANG=en-IN
